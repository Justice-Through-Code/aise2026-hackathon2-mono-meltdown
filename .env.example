# AISE ASK Environment Variables
# Copy this to .env and fill in your values

# Required: Your Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Required: JWT secret key (generate a strong random string)
SECRET_KEY=change-me-to-a-strong-random-secret

# Optional: Set to "chaos" for entertaining debug logs
DEBUG_MODE=off

# Optional: Database file path
DATABASE_PATH=aise_ask.db

# Optional: Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Optional: Groq model to use
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Max chat history messages per session
MAX_CHAT_HISTORY=10

# Optional: JWT token expiry in seconds (default: 24 hours)
TOKEN_EXPIRY_SECONDS=86400
